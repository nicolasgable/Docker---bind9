# Copiez ce fichier en .env et adaptez-le avant de deployer.

# ---------------------------------------------------------------- Serveur mail
# Nom DNS public du serveur (doit avoir un enregistrement A + PTR/reverse DNS)
MAIL_HOSTNAME=mail.example.local
# Domaines geres (separes par des virgules). Le premier est le domaine principal.
MAIL_DOMAINS=example.local
# Smarthost optionnel si votre FAI/hebergeur bloque le port 25 sortant
# ex: [smtp.fournisseur.fr]:587
MAIL_RELAYHOST=
# Reseaux autorises a relayer SANS authentification (laisser vide si inutile)
MAIL_EXTRA_MYNETWORKS=
# Taille max d'un message (octets) - 50 Mo
MAIL_MESSAGE_SIZE_LIMIT=52428800

# ---------------------------------------------------------------- LDAP
# Nom du reseau Docker de votre conteneur LDAP (docker network ls)
LDAP_NETWORK=ldap_network
# URI : nom du conteneur LDAP sur ce reseau
LDAP_URI=ldap://openldap:389
# yes = StartTLS vers le serveur LDAP
LDAP_START_TLS=no
LDAP_BASE_DN=dc=example,dc=local
# Compte de service en lecture seule (recherche des utilisateurs)
LDAP_BIND_DN=cn=admin,dc=example,dc=local
LDAP_BIND_PASSWORD=ChangeMe123!
# Branche contenant les utilisateurs (defaut : ou=users,<LDAP_BASE_DN>)
LDAP_USER_BASE=ou=users,dc=example,dc=local
LDAP_USER_OBJECTCLASS=inetOrgPerson
# Attribut contenant l'adresse mail / attribut identifiant de connexion
LDAP_MAIL_ATTRIBUTE=mail
LDAP_LOGIN_ATTRIBUTE=uid
# DN du groupe autorise a utiliser la messagerie
LDAP_MAIL_GROUP_DN=cn=mail,ou=groups,dc=example,dc=local
# Filtre d'appartenance au groupe. Par defaut (vide) :
#   (memberOf=<LDAP_MAIL_GROUP_DN>)  -> groupOfNames/groupOfUniqueNames + overlay memberOf
# Pour un posixGroup dont les membres ont le groupe "mail" comme groupe principal :
#   LDAP_GROUP_FILTER=(gidNumber=10000)
LDAP_GROUP_FILTER=

# ---------------------------------------------------------------- TLS / DKIM
# Certificats montes depuis ./certs (auto-signe genere si absents)
SSL_CERT_FILE=/etc/mail-certs/fullchain.pem
SSL_KEY_FILE=/etc/mail-certs/privkey.pem
DKIM_SELECTOR=mail
DKIM_KEY_BITS=2048

# ---------------------------------------------------------------- Debug
DOVECOT_AUTH_VERBOSE=yes
DOVECOT_AUTH_DEBUG=no
