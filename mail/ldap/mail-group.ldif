# Exemple : creation du groupe "mail" et d'un utilisateur membre.
# A adapter a votre annuaire (DN de base, branches ou=users / ou=groups) puis :
#   docker exec -i <conteneur_ldap> ldapadd -x -D "cn=admin,dc=example,dc=local" -W < ldap/mail-group.ldif
#
# Le filtre par defaut repose sur l'attribut "memberOf" (overlay memberOf).
# Le type de groupe a utiliser depend de la configuration de cet overlay :
#   - osixia/openldap : groupOfUniqueNames + uniqueMember   (exemple ci-dessous)
#   - autres images / OpenLDAP "maison" : souvent groupOfNames + member
# Verification :  ldapsearch ... -b ou=users,dc=example,dc=local memberOf

dn: uid=jdupont,ou=users,dc=example,dc=local
objectClass: inetOrgPerson
uid: jdupont
cn: Jean Dupont
sn: Dupont
mail: jdupont@example.local
userPassword: MotDePasseJean

dn: cn=mail,ou=groups,dc=example,dc=local
objectClass: groupOfUniqueNames
cn: mail
description: Utilisateurs autorises a utiliser la messagerie
uniqueMember: uid=jdupont,ou=users,dc=example,dc=local

# Variante groupOfNames :
# dn: cn=mail,ou=groups,dc=example,dc=local
# objectClass: groupOfNames
# cn: mail
# member: uid=jdupont,ou=users,dc=example,dc=local
